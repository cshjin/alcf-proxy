# Copy this file to .env (which is gitignored — never committed) and uncomment/edit below.
# alcf-proxy ships with no built-in default port, so pick one that's free on your machine.
# .env is loaded automatically from the current directory or the platform config dir; see
# docs/configuration.md for the full list of ALCF_PROXY_* settings and precedence order.

# ALCF_PROXY_PORT=11445

# Any other setting can go here too (same names as config.yaml, upper-cased with the
# ALCF_PROXY_ prefix):
# ALCF_PROXY_HOST=127.0.0.1
# ALCF_PROXY_CLUSTER=sophia
# ALCF_PROXY_FRAMEWORK=vllm
